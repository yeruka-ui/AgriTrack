--CALENDAR TABLE
CREATE TABLE CalendarTasks (
Id INT PRIMARY KEY IDENTITY(1,1),
Title NVARCHAR(200) NOT NULL,
StartTime DATETIME2 NOT NULL,
EndTime DATETIME2 NOT NULL,
Notes NVARCHAR(MAX) NULL,
IsComplete BIT NOT NULL DEFAULT 0
);

INSERT INTO CalendarTasks (Title, StartTime, EndTime, Notes, IsComplete)
VALUES
('Sample Task',
GETDATE(), -- Use current time
DATEADD(hour, 1, GETDATE()), -- Adds 1 hour to the current time
'This task is for testing and created in SSMS.', 0);

--HOLIDAYS TABLE
CREATE TABLE Holidays (
Id INT PRIMARY KEY IDENTITY(1,1),
Name NVARCHAR(100) NOT NULL,
Date DATETIME2 NOT NULL
);

--PRODUCE TABLE

CREATE TABLE [Produce] (
    [ProduceId] int NOT NULL IDENTITY(1,1),
    [ProduceType] nvarchar(max) NOT NULL,
    [Quantity] int NOT NULL,
    [Weight] nvarchar(max) NOT NULL,
    [HarvestDate] datetime2 NOT NULL,
    [Notes] nvarchar(max) NOT NULL,
    CONSTRAINT [PK_Produce] PRIMARY KEY ([ProduceId])
);


-- LIVESTOKC TABLE
CREATE TABLE [dbo].[Livestock] (
    [Id] INT IDENTITY(1,1) NOT NULL,
    [TagNumber] NVARCHAR(MAX) NULL,
    [Breed] NVARCHAR(MAX) NULL,
    [DateOfBirth] DATETIME2 NOT NULL,
    [Species] NVARCHAR(MAX) NULL,
    [Weight] NVARCHAR(MAX) NULL,
    [Gender] NVARCHAR(MAX) NULL,
    [Status] NVARCHAR(MAX) NULL,
    [Activity] NVARCHAR(MAX) NULL,
    [Notes] NVARCHAR(MAX) NULL,
    CONSTRAINT [PK_Livestock] PRIMARY KEY ([Id])
);
GO


-- Create Revenues Table
CREATE TABLE Revenues (
    RevenueID INT PRIMARY KEY IDENTITY(1,1),
    Amount FLOAT NOT NULL,
    Date DATE NOT NULL
);

-- Create Expenses Table
CREATE TABLE Expenses (
    ExpenseID INT PRIMARY KEY IDENTITY(1,1),
    Amount FLOAT NOT NULL,
    Date DATE NOT NULL
);

-- Create Investments Table
CREATE TABLE Investments (
    InvestmentID INT PRIMARY KEY IDENTITY(1,1),
    Amount FLOAT NOT NULL,
    Date DATE NOT NULL
);


