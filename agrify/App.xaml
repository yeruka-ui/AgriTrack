<Application
    x:Class="agrify.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utu="using:Uno.Toolkit.UI"
    xmlns:um="using:Uno.Material"
    xmlns:ut="using:Uno.Themes"
    xmlns:local="using:agrify">

    <Application.Resources>
        <ResourceDictionary>
        
            <!-- ✅ Merged theme resources -->
            <ResourceDictionary.MergedDictionaries>
                <!-- Base Uno + Material theme -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <um:MaterialColors />
                <um:MaterialResources />

                <!-- Custom overrides -->
                <ResourceDictionary Source="ms-appx:///Styles/ColorsOverrideLogin.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/FontsOverrideLogin.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ✅ Custom styles go here, NOT inside the merged dictionaries -->
            <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>

            <Style TargetType="PasswordBox" BasedOn="{StaticResource DefaultPasswordBoxStyle}">
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>

            <!-- ✅ Focus visuals override -->
            <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#8BC34A" />
            <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="#AED581" />
            <Thickness x:Key="FocusVisualMargin">0</Thickness>
            <Thickness x:Key="FocusVisualThickness">2</Thickness>

            

            
        </ResourceDictionary>

        



    </Application.Resources>

</Application>
