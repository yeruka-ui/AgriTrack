<Application
    x:Class="agrify.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utu="using:Uno.Toolkit.UI"
    xmlns:um="using:Uno.Material"
    xmlns:ut="using:Uno.Themes"
    xmlns:local="using:agrify">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <um:MaterialColors/>
                <um:MaterialResources/>
                <ResourceDictionary Source="ms-appx:///Styles/ColorsOverrideLogin.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/FontsOverrideLogin.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="BorderBrush" Value="#006F31" />
            </Style>

        
            
            <!-- ✅ Focus visuals override -->
   
            <Thickness x:Key="FocusVisualMargin">0</Thickness>
            <Thickness x:Key="FocusVisualThickness">2</Thickness>

           
            
        </ResourceDictionary>

        



    </Application.Resources>

</Application>
