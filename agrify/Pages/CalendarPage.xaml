<!-- 
  NOTE: Make sure the x:Class matches your C# file's namespace
  This should be: x:Class="agrify.Pages.CalendarPage"
-->
<Page
    x:Class="agrify.Pages.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:agrify.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:agrify.Models"
    mc:Ignorable="d"
    Background="#FF2D2D30">

    <Page.Resources>
        <!-- Style for the "Add Task" button -->
        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF006400"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <!-- Style for the sidebar toggle button -->
        <Style x:Key="ToggleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Template for each task in the sidebar list -->
        <DataTemplate x:Key="TaskTemplate" x:DataType="models:CalendarTask">
            <!-- UPDATED: Added a Grid to hold the "Complete" button -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,5,0,10" Spacing="4">
                    <TextBlock Text="{x:Bind Title}" 
                               Foreground="White" 
                               FontWeight="Bold" 
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{x:Bind FormattedTime}" 
                               Foreground="LightGray" 
                               FontSize="12"/>
                    <TextBlock Text="{x:Bind Notes}" 
                               Foreground="Gray" 
                               FontSize="12" 
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- NEW: "Complete Task" Button -->
                <Button Grid.Column="1" 
                        Content="&#xE73E;" 
                        FontFamily="Segoe MDL2 Assets"
                        Foreground="LightGreen"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CompleteTaskButton_Click"
                        ToolTipService.ToolTip="Mark as Complete"
                        Margin="10,0,0,0"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="HolidayTemplate" x:DataType="models:Holiday">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,5">
                <TextBlock Text="{x:Bind FormattedDate}" 
                           Foreground="White" 
                           FontWeight="Bold" />
                <TextBlock Text="{x:Bind Name}" 
                           Foreground="LightGray" 
                           TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>

        <!-- NEW: Template for the "Agenda" list -->
        <DataTemplate x:Key="AgendaTaskTemplate" x:DataType="models:CalendarTask">
            <Grid Padding="0,10" BorderBrush="Gray" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0" HorizontalAlignment="Left">
                    <!-- Binds to the StartTime, not just the time -->
                    <TextBlock Text="{x:Bind StartTime, Converter={StaticResource DateTimeToDayStringConverter}}" 
                               Foreground="White" 
                               FontWeight="Bold"
                               FontSize="16"/>
                    <TextBlock Text="{x:Bind StartTime, Converter={StaticResource DateTimeToDateStringConverter}}" 
                               Foreground="LightGray" 
                               FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{x:Bind Title}" 
                               Foreground="White" 
                               FontWeight="Bold" 
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{x:Bind FormattedTime}" 
                               Foreground="LightGray" 
                               FontSize="12"/>
                </StackPanel>

                <!-- NEW: "Complete Task" Button -->
                <Button Grid.Column="2" 
                        Content="&#xE73E;" 
                        FontFamily="Segoe MDL2 Assets"
                        Foreground="LightGreen"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CompleteTaskButton_Click"
                        ToolTipService.ToolTip="Mark as Complete"
                        Margin="10,0,0,0"/>
            </Grid>
        </DataTemplate>

        <!-- NEW: Converters for the Agenda list -->
        <local:DateTimeToDayStringConverter x:Key="DateTimeToDayStringConverter" />
        <local:DateTimeToDateStringConverter x:Key="DateTimeToDateStringConverter" />

    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <!-- The sidebar column. We give it a name so we can collapse it. -->
            <ColumnDefinition x:Name="SidebarColumn" Width="320" />
        </Grid.ColumnDefinitions>

        <!-- ======================================== -->
        <!-- COLUMN 0: MAIN CALENDAR & AGENDA         -->
        <!-- ======================================== -->
        <Grid Grid.Column="0" Padding="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- Header -->
                <RowDefinition Height="Auto" />
                <!-- Calendar (Fixed Size) -->
                <RowDefinition Height="Auto" />
                <!-- "Agenda" Title -->
                <RowDefinition Height="*" />
                <!-- NEW: Agenda List (Fills Space) -->
            </Grid.RowDefinitions>

            <!-- Row 0: Header with Title and Buttons -->
            <!-- 
            !!! THIS IS THE REAL FIX !!!
            This is a <Grid>, not a <StackPanel>.
            This makes the Width="*" for the spacer valid.
            -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Title -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Add Task -->
                    <ColumnDefinition Width="*"/>
                    <!-- Spacer -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Toggle -->
                </Grid.ColumnDefinitions>

                <TextBlock Text="Calendar" 
                           Grid.Column="0"
                           Foreground="White" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           VerticalAlignment="Center"/>

                <Button x:Name="AddTaskButton" 
                        Grid.Column="1"
                        Content="Add New Task"
                        Style="{StaticResource AccentButtonStyle}"
                        VerticalAlignment="Center"
                        Margin="10,0,0,0">
                    <!-- This is the pop-up for adding a new task -->
                    <Button.Flyout>
                        <Flyout x:Name="AddTaskFlyout" Placement="Bottom">
                            <StackPanel Spacing="10" Width="300">
                                <TextBlock Text="New Task" FontSize="18" FontWeight="Bold"/>
                                <TextBox x:Name="NewTaskTitleTextBox" Header="Task Title" PlaceholderText="e.g., Vet Appointment"/>
                                <DatePicker x:Name="NewTaskDatePicker" Header="Date"/>
                                <TimePicker x:Name="NewTaskTimePicker" Header="Time" ClockIdentifier="12Hour"/>
                                <TextBox x:Name="NewTaskNotesTextBox" Header="Notes (Optional)" Height="80" AcceptsReturn="True" TextWrapping="Wrap" />
                                <TextBlock x:Name="TaskErrorTextBlock" Foreground="Red" TextWrapping="Wrap"/>
                                <Button x:Name="SaveTaskButton" 
                                        Content="Save Task" 
                                        Click="SaveTaskButton_Click" 
                                        Style="{StaticResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- This spacer Rectangle now works because it's in a Grid -->
                <Rectangle Grid.Column="2" Fill="Transparent" HorizontalAlignment="Stretch" />

                <Button x:Name="ToggleSidebarButton"
                        Grid.Column="3"
                        Content="&#xE72A;" 
                        FontFamily="Segoe MDL2 Assets" 
                        ToolTipService.ToolTip="Toggle Task List"
                        Style="{StaticResource ToggleButtonStyle}"
                        Click="ToggleSidebarButton_Click" />
            </Grid>

            <!-- 
            Row 1: The Functional Calendar
            It's now aligned to the top. This fixes the wonky controls.
            -->
            <CalendarView x:Name="MainCalendarView"
                          Grid.Row="1"
                          VerticalAlignment="Top"
                          HorizontalAlignment="Stretch"
                          SelectionMode="Single"
                          SelectedDatesChanged="MainCalendarView_SelectedDatesChanged"
                          CalendarViewDayItemChanging="MainCalendarView_DayItemChanging"/>

            <!-- Row 2: NEW "Agenda" Title -->
            <TextBlock Text="Upcoming Tasks (Next 7 Days)"
                       Grid.Row="2"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,20,0,10"/>

            <!-- Row 3: NEW "Agenda" ListView (Fills the empty space) -->
            <ListView x:Name="UpcomingTasksListView"
                      Grid.Row="3"
                      ItemTemplate="{StaticResource AgendaTaskTemplate}"
                      SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

        </Grid>

        <!-- ======================================== -->
        <!-- COLUMN 1: SIDEBAR (TASK LIST)            -->
        <!-- ======================================== -->
        <Grid Grid.Column="1" Background="#FF3E3E42" Padding="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="*"/>
                <!-- Task List -->
                <RowDefinition Height="Auto"/>
                <!-- Holidays (static) -->
            </Grid.RowDefinitions>

            <!-- Sidebar Header -->
            <TextBlock x:Name="SidebarHeaderTextBlock"
                       Grid.Row="0"
                       Text="Tasks for Today"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="5,5,0,15"/>

            <!-- List of tasks for the selected day -->
            <ListView x:Name="TasksListView"
                      Grid.Row="1"
                      ItemTemplate="{StaticResource TaskTemplate}"
                      SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <!-- 
            UPDATED:
            This is now a dynamic ListView for Holidays, not a static StackPanel.
            -->
            <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                <Line X2="280" Stroke="DarkGray" StrokeThickness="1" Margin="0,10"/>
                <TextBlock Text="Holidays This Month  🎉" 
                           Foreground="White" 
                           FontWeight="Bold" 
                           Margin="5,10,0,10"/>

                <ListView x:Name="HolidaysListView"
                          ItemTemplate="{StaticResource HolidayTemplate}"
                          SelectionMode="None"
                          MaxHeight="150">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
