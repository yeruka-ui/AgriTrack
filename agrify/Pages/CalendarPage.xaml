
<Page
    x:Class="agrify.Pages.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:agrify.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:agrify.Models"
    mc:Ignorable="d"
    Background="White">

    <Page.Resources>
        <!-- Style for the "Add Task" button -->
        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#8DC63F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="ms-appx:///Assets/NewFolder/Poppins-SemiBold.ttf#Poppins"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,10"/>
        </Style>

        <!-- Style for the sidebar toggle button -->
        <Style x:Key="ToggleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#2D2D30"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Template for each task in the sidebar list -->
        <DataTemplate x:Key="TaskTemplate" x:DataType="models:CalendarTask">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,5,0,10" Spacing="4">
                    <TextBlock Text="{x:Bind Title}" 
                               Foreground="White" 
                               FontWeight="SemiBold"
                               FontFamily="ms-appx:///Assets/NewFolder/Poppins-SemiBold.ttf#Poppins"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{x:Bind FormattedTime}" 
                               Foreground="#E0E0E0" 
                               FontFamily="ms-appx:///Assets/NewFolder/Poppins-Regular.ttf#Poppins"
                               FontSize="12"/>
                    <TextBlock Text="{x:Bind Notes}" 
                               Foreground="#CCCCCC" 
                               FontFamily="ms-appx:///Assets/NewFolder/Poppins-Regular.ttf#Poppins"
                               FontSize="12" 
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Button Grid.Column="1" 
                        Content="&#xE73E;" 
                        FontFamily="Segoe MDL2 Assets"
                        Foreground="#8DC63F"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CompleteTaskButton_Click"
                        ToolTipService.ToolTip="Mark as Complete"
                        Margin="10,0,0,0"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="HolidayTemplate" x:DataType="models:Holiday">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,5">
                <TextBlock Text="{x:Bind FormattedDate}" 
                           Foreground="White" 
                           FontFamily="ms-appx:///Assets/NewFolder/Poppins-SemiBold.ttf#Poppins"
                           FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind Name}" 
                           Foreground="#E0E0E0"
                           FontFamily="ms-appx:///Assets/NewFolder/Poppins-Regular.ttf#Poppins"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>

        <!-- Template for the "Agenda" list -->
        <DataTemplate x:Key="AgendaTaskTemplate" x:DataType="models:CalendarTask">
            <Grid Padding="15,15" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0" HorizontalAlignment="Left" Width="80">
                    <TextBlock Text="{x:Bind StartTime, Converter={StaticResource DateTimeToDayStringConverter}}" 
                               Foreground="Black" 
                               FontWeight="Bold"
                               FontFamily="ms-appx:///Assets/NewFolder/Poppins-Bold.ttf#Poppins"
                               FontSize="14"/>
                    <TextBlock Text="{x:Bind StartTime, Converter={StaticResource DateTimeToDateStringConverter}}" 
                               Foreground="#666666"
                               FontFamily="ms-appx:///Assets/NewFolder/Poppins-Regular.ttf#Poppins"
                               FontSize="11"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{x:Bind Title}" 
                               Foreground="Black" 
                               FontWeight="SemiBold"
                               FontFamily="ms-appx:///Assets/NewFolder/Poppins-SemiBold.ttf#Poppins"
                               FontSize="14"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{x:Bind FormattedTime}" 
                               Foreground="#666666"
                               FontFamily="ms-appx:///Assets/NewFolder/Poppins-Regular.ttf#Poppins"
                               FontSize="12"/>
                </StackPanel>

                <Button Grid.Column="2" 
                        Content="&#xE73E;" 
                        FontFamily="Segoe MDL2 Assets"
                        Foreground="#8DC63F"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CompleteTaskButton_Click"
                        ToolTipService.ToolTip="Mark as Complete"
                        Margin="10,0,0,0"/>
            </Grid>
        </DataTemplate>

        <!-- Converters for the Agenda list -->
        <local:DateTimeToDayStringConverter x:Key="DateTimeToDayStringConverter" />
        <local:DateTimeToDateStringConverter x:Key="DateTimeToDateStringConverter" />

    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <!-- Main content area -->
            <ColumnDefinition x:Name="SidebarColumn" Width="320" />
            <!-- Sidebar -->
        </Grid.ColumnDefinitions>

        <!-- ======================================== -->
        <!-- COLUMN 0: MAIN CALENDAR & AGENDA         -->
        <!-- ======================================== -->
        <Grid Grid.Column="0" Padding="40,30" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- Header -->
                <RowDefinition Height="Auto" />
                <!-- Calendar -->
                <RowDefinition Height="Auto" />
                <!-- "Agenda" Title -->
                <RowDefinition Height="*" />
                <!-- Agenda List -->
            </Grid.RowDefinitions>

            <!-- Row 0: Header with Title and Buttons -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Title -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Add Task -->
                    <ColumnDefinition Width="*"/>
                    <!-- Spacer -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Toggle -->
                </Grid.ColumnDefinitions>

                <TextBlock Text="Calendar" 
                           Grid.Column="0"
                           Foreground="Black" 
                           FontSize="28" 
                           FontWeight="SemiBold"
                           FontFamily="ms-appx:///Assets/NewFolder/Poppins-SemiBold.ttf#Poppins"
                           VerticalAlignment="Center"/>

                <Button x:Name="AddTaskButton" 
                        Grid.Column="1"
                        Content="Add New Task"
                        Style="{StaticResource AccentButtonStyle}"
                        VerticalAlignment="Center"
                        Margin="15,0,0,0">
                    <Button.Flyout>
                        <Flyout x:Name="AddTaskFlyout" Placement="Bottom">
                            <StackPanel Spacing="10" Width="300">
                                <TextBlock Text="New Task" 
                                          FontSize="18" 
                                          FontWeight="SemiBold"
                                          FontFamily="ms-appx:///Assets/NewFolder/Poppins-SemiBold.ttf#Poppins"/>
                                <TextBox x:Name="NewTaskTitleTextBox" 
                                        Header="Task Title" 
                                        PlaceholderText="e.g., Vet Appointment"
                                        FontFamily="ms-appx:///Assets/NewFolder/Poppins-Regular.ttf#Poppins"/>
                                <DatePicker x:Name="NewTaskDatePicker" 
                                           Header="Date"
                                           FontFamily="ms-appx:///Assets/NewFolder/Poppins-Regular.ttf#Poppins"/>
                                <TimePicker x:Name="NewTaskTimePicker" 
                                           Header="Time" 
                                           ClockIdentifier="12Hour"
                                           FontFamily="ms-appx:///Assets/NewFolder/Poppins-Regular.ttf#Poppins"/>
                                <TextBox x:Name="NewTaskNotesTextBox" 
                                        Header="Notes (Optional)" 
                                        Height="80" 
                                        AcceptsReturn="True" 
                                        TextWrapping="Wrap"
                                        FontFamily="ms-appx:///Assets/NewFolder/Poppins-Regular.ttf#Poppins"/>
                                <TextBlock x:Name="TaskErrorTextBlock" 
                                          Foreground="Red" 
                                          TextWrapping="Wrap"
                                          FontFamily="ms-appx:///Assets/NewFolder/Poppins-Regular.ttf#Poppins"/>
                                <Button x:Name="SaveTaskButton" 
                                        Content="Save Task" 
                                        Click="SaveTaskButton_Click" 
                                        Style="{StaticResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- Spacer -->
                <Rectangle Grid.Column="2" Fill="Transparent" HorizontalAlignment="Stretch" />

                <Button x:Name="ToggleSidebarButton"
                        Grid.Column="3"
                        Content="&#xE8A0;" 
                        FontFamily="Segoe MDL2 Assets" 
                        Style="{StaticResource ToggleButtonStyle}"
                        Click="ToggleSidebarButton_Click" />
            </Grid>

            <!-- Row 1: Calendar View (Reduced Height) -->
            <CalendarView TodayBackground="#8DC63F" CalendarItemPressedBackground="Chartreuse" SelectedBackground="Transparent" x:Name="MainCalendarView"
                          Grid.Row="1"
                          MinWidth="450"
                          MaxWidth="1200"
                          MinHeight="350"
                          MaxHeight="400"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Top"
                          SelectionMode="Single"
                          SelectedDatesChanged="MainCalendarView_SelectedDatesChanged"
                          CalendarViewDayItemChanging="MainCalendarView_DayItemChanging"
                          Foreground="Black"
                          Background="White"
                          RequestedTheme="Light"
                          FirstDayOfWeek="Sunday"
                          Margin="0,0,0,30"/>

            <!-- Row 2: "Agenda" Title -->
            <TextBlock Text="Upcoming Tasks (Next 7 Days)"
                       Grid.Row="2"
                       Foreground="Black"
                       FontSize="20"
                       FontWeight="SemiBold"
                       FontFamily="ms-appx:///Assets/NewFolder/Poppins-SemiBold.ttf#Poppins"
                       Margin="0,0,0,15"/>

            <!-- Row 3: "Agenda" ListView -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <ListView x:Name="UpcomingTasksListView"
                          ItemTemplate="{StaticResource AgendaTaskTemplate}"
                          SelectionMode="None"
                          Background="White">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </ScrollViewer>

        </Grid>

        <!-- ======================================== -->
        <!-- COLUMN 1: SIDEBAR (TASK LIST)            -->
        <!-- ======================================== -->
        <Grid Grid.Column="1" Padding="15">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#734A00" Offset="0" />
                    <GradientStop Color="#462E04" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="*"/>
                <!-- Task List -->
                <RowDefinition Height="Auto"/>
                <!-- Holidays -->
            </Grid.RowDefinitions>

            <!-- Sidebar Header -->
            <TextBlock x:Name="SidebarHeaderTextBlock"
                       Grid.Row="0"
                       Text="Tasks for Today"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="SemiBold"
                       FontFamily="ms-appx:///Assets/NewFolder/Poppins-SemiBold.ttf#Poppins"
                       Margin="5,5,0,15"/>

            <!-- List of tasks for the selected day -->
            <ListView x:Name="TasksListView"
                      Grid.Row="1"
                      ItemTemplate="{StaticResource TaskTemplate}"
                      SelectionMode="None"
                      Background="Transparent">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <!-- Holidays Section -->
            <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                <Line X2="280" Stroke="#FFFFFF" StrokeThickness="1" Margin="0,10" Opacity="0.3"/>
                <TextBlock Text="Holidays This Month  🎉" 
                           Foreground="White" 
                           FontWeight="SemiBold"
                           FontFamily="ms-appx:///Assets/NewFolder/Poppins-SemiBold.ttf#Poppins"
                           Margin="5,10,0,10"/>

                <ListView x:Name="HolidaysListView"
                          ItemTemplate="{StaticResource HolidayTemplate}"
                          SelectionMode="None"
                          MaxHeight="150"
                          Background="Transparent">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </StackPanel>
        </Grid>
    </Grid>
</Page>