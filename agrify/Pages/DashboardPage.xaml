<Page
    x:Class="agrify.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:agrify.Pages"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#FF2D2D30"
    Loaded="Page_Loaded">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <TextBlock Text="FARM DASHBOARD" Grid.Row="0" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,0,0,24"/>

        <!-- 2. KPI Cards Row -->
        <Grid Grid.Row="1" ColumnSpacing="16" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Livestock -->
            <Border Grid.Column="0" Background="#FF3E3E42" CornerRadius="12" Padding="16">
                <StackPanel>
                    <TextBlock Text="Total Livestock" Foreground="#AAAAAA" FontSize="12"/>
                    <TextBlock Text="{Binding TotalLivestock}" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/>
                    <!-- UPDATED BINDING HERE -->
                    <TextBlock Text="{Binding ActiveHerdLabel}" Foreground="#00FF00" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Milk Cost -->
            <Border Grid.Column="1" Background="#FF3E3E42" CornerRadius="12" Padding="16">
                <StackPanel>
                    <TextBlock Text="Milk Cost (Per Liter)" Foreground="#AAAAAA" FontSize="12"/>
                    <TextBlock Text="{Binding MilkCostPerLiter}" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/>
                    <TextBlock Text="Target: &lt; Rs 1,000" Foreground="Orange" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Qurbani -->
            <Border Grid.Column="2" Background="#FF3E3E42" CornerRadius="12" Padding="16">
                <StackPanel>
                    <TextBlock Text="Qurbani Ready" Foreground="#AAAAAA" FontSize="12"/>
                    <TextBlock Text="{Binding QurbaniReadyCount}" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/>
                    <TextBlock Text="Eid Projection" Foreground="#AAAAAA" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Feed Cost -->
            <Border Grid.Column="3" Background="#FF3E3E42" CornerRadius="12" Padding="16">
                <StackPanel>
                    <TextBlock Text="Feed Daily Cost" Foreground="#AAAAAA" FontSize="12"/>
                    <TextBlock Text="{Binding FeedDailyCost}" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Main Content Area (Swapped Layout) -->
        <Grid Grid.Row="2" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN -->
            <Grid Grid.Column="0" RowSpacing="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>

                <!-- Milk Chart -->
                <Border Grid.Row="0" Background="#FF3E3E42" CornerRadius="16" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="MILK TREND" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Last 7 Days" Foreground="#AAAAAA" FontSize="12"/>
                        </StackPanel>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding MilkProductionTrend}" VerticalAlignment="Bottom" Margin="0,15,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Bottom">
                                        <Rectangle Width="15" Height="{Binding BarHeight}" Fill="{Binding BarColor}" RadiusX="2" RadiusY="2"/>
                                        <TextBlock Text="{Binding DayLabel}" HorizontalAlignment="Center" Foreground="White" FontSize="10" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- NEW KPI: BIRTHS -->
                <Border Grid.Row="1" Background="#FF3E3E42" CornerRadius="16" Padding="20">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE779;" FontFamily="Segoe MDL2 Assets" Foreground="#00FF00" FontSize="24"/>
                            <StackPanel>
                                <TextBlock Text="NEW BIRTHS" FontWeight="Bold" Foreground="White" FontSize="14"/>
                                <TextBlock Text="This Month" Foreground="#AAAAAA" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding NewBirthsCount}" Foreground="White" FontSize="32" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBlock Text="Healthy Calves/Kids" Foreground="#00FF00" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- RIGHT COLUMN (Reminders) -->
            <Border Grid.Column="1" Background="#FF3E3E42" CornerRadius="16" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,20">
                        <SymbolIcon Symbol="Calendar" Foreground="White"/>
                        <TextBlock Text="SCHEDULE &amp; REMINDERS (NEXT 7 DAYS)" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ListView Grid.Row="1" ItemsSource="{Binding UpcomingReminders}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Background="#33FFFFFF" CornerRadius="8" Padding="5" HorizontalAlignment="Left" Width="60">
                                        <TextBlock Text="{Binding Date}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="Operational Task" Foreground="#AAAAAA" FontSize="11"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" Background="#22000000" BorderBrush="{Binding StatusBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="12" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
