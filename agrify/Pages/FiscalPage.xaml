<Page
    x:Class="agrify.Pages.FiscalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:agrify.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="White">

    <Grid>
        <ScrollViewer>
            <Grid Padding="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- HEADER -->
                <TextBlock Text="Expenses &amp; Revenue"
                           FontSize="32"
                           FontWeight="SemiBold"
                           FontFamily="ms-appx:///Assets/NewFolder/Poppins-SemiBold.ttf#Poppins"
                           Margin="0,0,0,20"
                           Foreground="Black"/>

                <!-- KPI BAR -->
                <Grid Grid.Row="1" Margin="0,20,0,30" ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total Revenue -->
                    <Border Grid.Column="0" 
                            Background="White"
                            CornerRadius="12"
                            Padding="20"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1">
                        <Border.Shadow>
                            <ThemeShadow />
                        </Border.Shadow>
                        <StackPanel Spacing="10">
                            <TextBlock Text="Total Revenue" 
                                       Foreground="#666666" 
                                       FontSize="14"
                                       FontFamily="ms-appx:///Assets/NewFolder/Poppins-Regular.ttf#Poppins"/>
                            <Border Background="#8DC63F" 
                                    CornerRadius="8" 
                                    Padding="20,15">
                                <TextBlock x:Name="TotalRevenueText" 
                                           Text="₱0.00" 
                                           FontSize="24" 
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontFamily="ms-appx:///Assets/NewFolder/Poppins-Bold.ttf#Poppins"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Monthly Profit -->
                    <Border Grid.Column="1" 
                            Background="White"
                            CornerRadius="12"
                            Padding="20"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1">
                        <Border.Shadow>
                            <ThemeShadow />
                        </Border.Shadow>
                        <StackPanel Spacing="10">
                            <TextBlock Text="Monthly Profit" 
                                       Foreground="#666666" 
                                       FontSize="14"
                                       FontFamily="ms-appx:///Assets/NewFolder/Poppins-Regular.ttf#Poppins"/>
                            <Border Background="#8DC63F" 
                                    CornerRadius="8" 
                                    Padding="20,15">
                                <TextBlock x:Name="MonthlyProfitText" 
                                           Text="₱0.00" 
                                           FontSize="24" 
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontFamily="ms-appx:///Assets/NewFolder/Poppins-Bold.ttf#Poppins"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ROI -->
                    <Border Grid.Column="2" 
                            Background="White"
                            CornerRadius="12"
                            Padding="20"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1">
                        <Border.Shadow>
                            <ThemeShadow />
                        </Border.Shadow>
                        <StackPanel Spacing="10">
                            <TextBlock Text="Return of Investment" 
                                       Foreground="#666666" 
                                       FontSize="14"
                                       FontFamily="ms-appx:///Assets/NewFolder/Poppins-Regular.ttf#Poppins"/>
                            <Border Background="#8DC63F" 
                                    CornerRadius="8" 
                                    Padding="20,15">
                                <TextBlock x:Name="RoiText" 
                                           Text="0%" 
                                           FontSize="24" 
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontFamily="ms-appx:///Assets/NewFolder/Poppins-Bold.ttf#Poppins"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- MONTHLY PROFIT & LOSS INPUTS -->
                <TextBlock Grid.Row="2"
                           Text="Monthly Profit &amp; Loss"
                           FontSize="22"
                           FontWeight="SemiBold"
                           FontFamily="ms-appx:///Assets/NewFolder/Poppins-SemiBold.ttf#Poppins"
                           Foreground="Black"
                           Margin="0,20,0,10"/>

                <Border Grid.Row="3"
                        Background="White"
                        CornerRadius="12"
                        Padding="20"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        Margin="0,0,0,20">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <StackPanel Spacing="15">

                        <TextBlock Text="Enter Total Revenue:" 
                                   Foreground="#666666"
                                   FontFamily="ms-appx:///Assets/NewFolder/Poppins-Regular.ttf#Poppins"/>
                        <TextBox x:Name="RevenueInput" 
                                 PlaceholderText="₱0.00"
                                 Background="#EAFFCE"
                                 FontFamily="ms-appx:///Assets/NewFolder/Poppins-Regular.ttf#Poppins">
                            <TextBox.InputScope>
                                <InputScope>
                                    <InputScope.Names>
                                        <InputScopeName NameValue="Number"/>
                                    </InputScope.Names>
                                </InputScope>
                            </TextBox.InputScope>
                        </TextBox>

                        <TextBlock Text="Enter Total Expense:" 
                                   Foreground="#666666"
                                   FontFamily="ms-appx:///Assets/NewFolder/Poppins-Regular.ttf#Poppins"/>
                        <TextBox x:Name="ExpenseInput" 
                                 PlaceholderText="₱0.00"
                                 Background="#EAFFCE"
                                 FontFamily="ms-appx:///Assets/NewFolder/Poppins-Regular.ttf#Poppins">
                            <TextBox.InputScope>
                                <InputScope>
                                    <InputScope.Names>
                                        <InputScopeName NameValue="Number"/>
                                    </InputScope.Names>
                                </InputScope>
                            </TextBox.InputScope>
                        </TextBox>

                        <Button Content="CALCULATE MONTHLY PROFIT"
                                Background="#8DC63F"
                                Foreground="White"
                                FontWeight="SemiBold"
                                FontFamily="ms-appx:///Assets/NewFolder/Poppins-SemiBold.ttf#Poppins"
                                CornerRadius="8"
                                Padding="20,12"
                                HorizontalAlignment="Stretch"
                                Click="CalculateProfit_Click">
                            <Button.Shadow>
                                <ThemeShadow />
                            </Button.Shadow>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ROI INPUTS -->
                <TextBlock Grid.Row="4"
                           Text="ROI (Return of Investment)"
                           FontSize="22"
                           FontWeight="SemiBold"
                           FontFamily="ms-appx:///Assets/NewFolder/Poppins-SemiBold.ttf#Poppins"
                           Foreground="Black"
                           Margin="0,10,0,10"/>

                <Border Grid.Row="5"
                        Background="White"
                        CornerRadius="12"
                        Padding="20"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <StackPanel Spacing="15">

                        <TextBlock Text="Enter Total Investment:" 
                                   Foreground="#666666"
                                   FontFamily="ms-appx:///Assets/NewFolder/Poppins-Regular.ttf#Poppins"/>
                        <TextBox x:Name="InvestmentInput" 
                                 PlaceholderText="₱0.00"
                                 Background="#EAFFCE"
                                 FontFamily="ms-appx:///Assets/NewFolder/Poppins-Regular.ttf#Poppins">
                            <TextBox.InputScope>
                                <InputScope>
                                    <InputScope.Names>
                                        <InputScopeName NameValue="Number"/>
                                    </InputScope.Names>
                                </InputScope>
                            </TextBox.InputScope>
                        </TextBox>

                        <TextBlock Text="Enter Total Revenue:" 
                                   Foreground="#666666"
                                   FontFamily="ms-appx:///Assets/NewFolder/Poppins-Regular.ttf#Poppins"/>
                        <TextBox x:Name="RevenueForRoiInput" 
                                 PlaceholderText="₱0.00"
                                 Background="#EAFFCE"
                                 FontFamily="ms-appx:///Assets/NewFolder/Poppins-Regular.ttf#Poppins">
                            <TextBox.InputScope>
                                <InputScope>
                                    <InputScope.Names>
                                        <InputScopeName NameValue="Number"/>
                                    </InputScope.Names>
                                </InputScope>
                            </TextBox.InputScope>
                        </TextBox>

                        <Button Content="CALCULATE ROI"
                                Background="#8DC63F"
                                Foreground="White"
                                FontWeight="SemiBold"
                                FontFamily="ms-appx:///Assets/NewFolder/Poppins-SemiBold.ttf#Poppins"
                                CornerRadius="8"
                                Padding="20,12"
                                HorizontalAlignment="Stretch"
                                Click="CalculateRoi_Click">
                            <Button.Shadow>
                                <ThemeShadow />
                            </Button.Shadow>
                        </Button>
                    </StackPanel>
                </Border>

            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
