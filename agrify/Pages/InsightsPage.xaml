<Page
    x:Class="agrify.Pages.InsightsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:agrify.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    mc:Ignorable="d"
    Background="White"
    Loaded="Page_Loaded">

    <ScrollViewer>
        <Grid Padding="48">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- Title -->
                <RowDefinition Height="Auto" />
                <!-- KPI Cards -->
                <RowDefinition Height="Auto" />
                <!-- CHART (MANUAL) -->
                <RowDefinition Height="Auto" />
                <!-- Recent Activity Title -->
                <RowDefinition Height="*" />
                <!-- DataGrid -->
            </Grid.RowDefinitions>

            <!-- Row 0: Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,30">
                <TextBlock Text="FARM INSIGHTS &amp; PRODUCTION" 
                           Foreground="Black" 
                           FontSize="24" 
                           FontWeight="SemiBold"
                           FontFamily="ms-appx:///Assets/NewFolder/Poppins-SemiBold.ttf#Poppins"/>
                <TextBlock Text="Current Performance Metrics" 
                           Foreground="#666666" 
                           FontSize="14"
                           FontFamily="ms-appx:///Assets/NewFolder/Poppins-Regular.ttf#Poppins"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Row 1: KPI Cards -->
            <Grid Grid.Row="1" ColumnSpacing="20" Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Card 1 -->
                <Border Grid.Column="0" 
                        Background="White" 
                        CornerRadius="12" 
                        Padding="20"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <StackPanel>
                        <TextBlock Text="TOTAL LIVESTOCK" 
                                   Foreground="#666666" 
                                   FontWeight="SemiBold" 
                                   FontSize="12"
                                   FontFamily="ms-appx:///Assets/NewFolder/Poppins-SemiBold.ttf#Poppins"/>
                        <TextBlock Text="{Binding TotalHerdText}" 
                                   Foreground="Black" 
                                   FontSize="36" 
                                   FontWeight="Bold"
                                   FontFamily="ms-appx:///Assets/NewFolder/Poppins-Bold.ttf#Poppins"
                                   Margin="0,10,0,10"/>
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <TextBlock Text="{Binding ActiveCountText}" 
                                       Foreground="Black" 
                                       FontWeight="SemiBold"
                                       FontFamily="ms-appx:///Assets/NewFolder/Poppins-SemiBold.ttf#Poppins"/>
                            <TextBlock Text="Active" 
                                       Foreground="#8DC63F" 
                                       FontSize="12" 
                                       VerticalAlignment="Center"
                                       FontFamily="ms-appx:///Assets/NewFolder/Poppins-Regular.ttf#Poppins"/>
                            <TextBlock Text="{Binding DeadCountText}" 
                                       Foreground="Black" 
                                       FontWeight="SemiBold"
                                       FontFamily="ms-appx:///Assets/NewFolder/Poppins-SemiBold.ttf#Poppins"/>
                            <TextBlock Text="Dead" 
                                       Foreground="#FF6666" 
                                       FontSize="12" 
                                       VerticalAlignment="Center"
                                       FontFamily="ms-appx:///Assets/NewFolder/Poppins-Regular.ttf#Poppins"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card 2 -->
                <Border Grid.Column="1" 
                        Background="White" 
                        CornerRadius="12" 
                        Padding="20"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <StackPanel>
                        <TextBlock Text="PRODUCED TODAY (KG)" 
                                   Foreground="#666666" 
                                   FontWeight="SemiBold" 
                                   FontSize="12"
                                   FontFamily="ms-appx:///Assets/NewFolder/Poppins-SemiBold.ttf#Poppins"/>
                        <TextBlock Text="{Binding YieldTodayText}" 
                                   Foreground="Black" 
                                   FontSize="36" 
                                   FontWeight="Bold"
                                   FontFamily="ms-appx:///Assets/NewFolder/Poppins-Bold.ttf#Poppins"
                                   Margin="0,10,0,10"/>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="vs. Yesterday: " 
                                       Foreground="#666666" 
                                       FontSize="12"
                                       FontFamily="ms-appx:///Assets/NewFolder/Poppins-Regular.ttf#Poppins"/>
                            <TextBlock Text="{Binding YieldTrendText}" 
                                       Foreground="{Binding YieldTrendColor}" 
                                       FontWeight="SemiBold" 
                                       FontSize="12"
                                       FontFamily="ms-appx:///Assets/NewFolder/Poppins-SemiBold.ttf#Poppins"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card 3 -->
                <Border Grid.Column="2" 
                        Background="White" 
                        CornerRadius="12" 
                        Padding="20"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <StackPanel>
                        <TextBlock Text="HERD HEALTH" 
                                   Foreground="#666666" 
                                   FontWeight="SemiBold" 
                                   FontSize="12"
                                   FontFamily="ms-appx:///Assets/NewFolder/Poppins-SemiBold.ttf#Poppins"/>
                        <TextBlock Text="{Binding HealthStatusText}" 
                                   Foreground="{Binding HealthStatusColor}" 
                                   FontSize="36" 
                                   FontWeight="Bold"
                                   FontFamily="ms-appx:///Assets/NewFolder/Poppins-Bold.ttf#Poppins"
                                   Margin="0,10,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Mortality Rate: " 
                                       Foreground="#666666" 
                                       FontSize="12"
                                       FontFamily="ms-appx:///Assets/NewFolder/Poppins-Regular.ttf#Poppins"/>
                            <TextBlock Text="{Binding MortalityRateText}" 
                                       Foreground="Black" 
                                       FontWeight="SemiBold" 
                                       FontSize="12"
                                       FontFamily="ms-appx:///Assets/NewFolder/Poppins-SemiBold.ttf#Poppins"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 2: WEEKLY CHART (MANUAL XAML IMPLEMENTATION) -->
            <Border Grid.Row="2" 
                    Background="White" 
                    CornerRadius="12" 
                    Padding="20" 
                    Margin="0,0,0,30"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="WEEKLY HARVEST TREND (LAST 7 DAYS)" 
                                   Foreground="#666666" 
                                   FontWeight="SemiBold" 
                                   FontSize="12"
                                   FontFamily="ms-appx:///Assets/NewFolder/Poppins-SemiBold.ttf#Poppins"/>
                        <TextBlock Text="(KG)" 
                                   Foreground="#999999" 
                                   FontSize="12"
                                   FontFamily="ms-appx:///Assets/NewFolder/Poppins-Regular.ttf#Poppins"/>
                    </StackPanel>

                    <!-- The Chart Itself -->
                    <ItemsControl ItemsSource="{Binding WeeklyTrendList}" Grid.Row="1" Margin="0,20,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- Arranges bars horizontally -->
                                <StackPanel Orientation="Horizontal" Spacing="30" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Bottom">
                                    <!-- Value Label -->
                                    <TextBlock Text="{Binding ValueLabel}" 
                                               FontSize="10" 
                                               Foreground="#666666" 
                                               HorizontalAlignment="Center"
                                               FontFamily="ms-appx:///Assets/NewFolder/Poppins-Regular.ttf#Poppins"
                                               Margin="0,0,0,4"/>

                                    <!-- The Bar -->
                                    <Rectangle Width="30" 
                                               Height="{Binding BarHeight}" 
                                               Fill="{Binding BarColor}" 
                                               RadiusX="4" 
                                               RadiusY="4"/>

                                    <!-- Day Label -->
                                    <TextBlock Text="{Binding DayLabel}" 
                                               FontSize="12" 
                                               Foreground="Black" 
                                               HorizontalAlignment="Center"
                                               FontFamily="ms-appx:///Assets/NewFolder/Poppins-Regular.ttf#Poppins"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Row 3: Recent Activity Header & Actions -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Text="RECENT PRODUCTION LOGS"
                           Foreground="Black"
                           FontSize="16"
                           FontWeight="SemiBold"
                           FontFamily="ms-appx:///Assets/NewFolder/Poppins-SemiBold.ttf#Poppins"
                           VerticalAlignment="Center"/>

                <!-- Refresh Button -->
                <Button Content="Refresh" 
                        Click="Page_Loaded" 
                        Margin="20,0,0,0" 
                        FontSize="12" 
                        Height="30"
                        Background="#8DC63F"
                        Foreground="White"
                        FontWeight="SemiBold"
                        FontFamily="ms-appx:///Assets/NewFolder/Poppins-SemiBold.ttf#Poppins"
                        CornerRadius="6">
                    <Button.Shadow>
                        <ThemeShadow />
                    </Button.Shadow>
                </Button>

                <!-- Export Button -->
                <Button Click="ExportButton_Click" 
                        Margin="10,0,0,0" 
                        FontSize="12" 
                        Height="30"
                        Background="#8DC63F" 
                        Foreground="White" 
                        FontWeight="SemiBold"
                        FontFamily="ms-appx:///Assets/NewFolder/Poppins-SemiBold.ttf#Poppins"
                        CornerRadius="6">
                    <Button.Shadow>
                        <ThemeShadow />
                    </Button.Shadow>
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                            <TextBlock Text="Save Report"
                                       FontFamily="ms-appx:///Assets/NewFolder/Poppins-SemiBold.ttf#Poppins"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
            </StackPanel>

            <!-- Row 4: DataGrid -->
            <Border Grid.Row="4"
                    Background="White"
                    CornerRadius="12"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    Padding="10">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <controls:DataGrid BorderBrush="AntiqueWhite" Foreground="#3B8C20" ItemsSource="{Binding RecentProductionList}"
                                   AutoGenerateColumns="False"
                                   IsReadOnly="True"
                                   GridLinesVisibility="Horizontal"
                                   VerticalScrollBarVisibility="Auto"
                                   Background="White"
                                   MinHeight="300">
                    <controls:DataGrid.Columns>
                        <controls:DataGridTextColumn Header="Harvest Date" Binding="{Binding HarvestDateFormatted}" Width="150" />
                        <controls:DataGridTextColumn Header="Type" Binding="{Binding ProduceType}" Width="*" />
                        <controls:DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="100" />
                        <controls:DataGridTextColumn Header="Weight" Binding="{Binding Weight}" Width="120" />
                        <controls:DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="200" />
                    </controls:DataGrid.Columns>
                </controls:DataGrid>
            </Border>

        </Grid>
    </ScrollViewer>
</Page>
