<Page
    x:Class="agrify.Pages.InsightsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:agrify.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    mc:Ignorable="d"
    Background="#FF2D2D30"
    Loaded="Page_Loaded">

    <ScrollViewer>
        <Grid Padding="48">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- Title -->
                <RowDefinition Height="Auto" />
                <!-- KPI Cards -->
                <RowDefinition Height="Auto" />
                <!-- CHART (MANUAL) -->
                <RowDefinition Height="Auto" />
                <!-- Recent Activity Title -->
                <RowDefinition Height="*" />
                <!-- DataGrid -->
            </Grid.RowDefinitions>

            <!-- Row 0: Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,30">
                <TextBlock Text="FARM INSIGHTS &amp; PRODUCTION" Foreground="White" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="Current Performance Metrics" Foreground="LightGray" FontSize="14" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Row 1: KPI Cards -->
            <Grid Grid.Row="1" ColumnSpacing="20" Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Card 1 -->
                <Border Grid.Column="0" Background="#FF3E3E42" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <TextBlock Text="TOTAL LIVESTOCK" Foreground="#AAAAAA" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="{Binding TotalHerdText}" Foreground="White" FontSize="36" FontWeight="Bold" Margin="0,10,0,10"/>
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <TextBlock Text="{Binding ActiveCountText}" Foreground="White" FontWeight="Bold"/>
                            <TextBlock Text="Active" Foreground="#00FF00" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DeadCountText}" Foreground="White" FontWeight="Bold"/>
                            <TextBlock Text="Dead" Foreground="#FF6666" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card 2 -->
                <Border Grid.Column="1" Background="#FF3E3E42" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <TextBlock Text="PRODUCED TODAY (KG)" Foreground="#AAAAAA" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="{Binding YieldTodayText}" Foreground="White" FontSize="36" FontWeight="Bold" Margin="0,10,0,10"/>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="vs. Yesterday: " Foreground="LightGray" FontSize="12"/>
                            <TextBlock Text="{Binding YieldTrendText}" Foreground="{Binding YieldTrendColor}" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card 3 -->
                <Border Grid.Column="2" Background="#FF3E3E42" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <TextBlock Text="HERD HEALTH" Foreground="#AAAAAA" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="{Binding HealthStatusText}" Foreground="{Binding HealthStatusColor}" FontSize="36" FontWeight="Bold" Margin="0,10,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Mortality Rate: " Foreground="LightGray" FontSize="12"/>
                            <TextBlock Text="{Binding MortalityRateText}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 2: WEEKLY CHART (MANUAL XAML IMPLEMENTATION) -->
            <Border Grid.Row="2" Background="#FF3E3E42" CornerRadius="8" Padding="20" Margin="0,0,0,30">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="WEEKLY HARVEST TREND (LAST 7 DAYS)" Foreground="#AAAAAA" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="(KG)" Foreground="#666666" FontSize="12"/>
                    </StackPanel>

                    <!-- The Chart Itself -->
                    <ItemsControl ItemsSource="{Binding WeeklyTrendList}" Grid.Row="1" Margin="0,20,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- Arranges bars horizontally -->
                                <StackPanel Orientation="Horizontal" Spacing="30" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Bottom">
                                    <!-- Value Label -->
                                    <TextBlock Text="{Binding ValueLabel}" 
                                               FontSize="10" 
                                               Foreground="LightGray" 
                                               HorizontalAlignment="Center" 
                                               Margin="0,0,0,4"/>

                                    <!-- The Bar -->
                                    <Rectangle Width="30" 
                                               Height="{Binding BarHeight}" 
                                               Fill="{Binding BarColor}" 
                                               RadiusX="4" 
                                               RadiusY="4"/>

                                    <!-- Day Label -->
                                    <TextBlock Text="{Binding DayLabel}" 
                                               FontSize="12" 
                                               Foreground="White" 
                                               HorizontalAlignment="Center" 
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Row 3: Recent Activity Header & Actions -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Text="RECENT PRODUCTION LOGS"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <!-- Refresh Button -->
                <Button Content="Refresh" Click="Page_Loaded" Margin="20,0,0,0" FontSize="12" Height="30"/>

                <!-- Export Button -->
                <Button
                        Click="ExportButton_Click" 
                        Margin="10,0,0,0" 
                        FontSize="12" 
                        Height="30"
                        Background="#FF006400" 
                        Foreground="White" 
                        FontWeight="Bold">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                            <TextBlock Text="Save Report"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
            </StackPanel>

            <!-- Row 4: DataGrid -->
            <controls:DataGrid ItemsSource="{Binding RecentProductionList}"
                               Grid.Row="4"
                               AutoGenerateColumns="False"
                               IsReadOnly="True"
                               GridLinesVisibility="Horizontal"
                               VerticalScrollBarVisibility="Auto"
                               MinHeight="300">
                <controls:DataGrid.Columns>
                    <controls:DataGridTextColumn Header="Harvest Date" Binding="{Binding HarvestDateFormatted}" Width="150" />
                    <controls:DataGridTextColumn Header="Type" Binding="{Binding ProduceType}" Width="*" />
                    <controls:DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="100" />
                    <controls:DataGridTextColumn Header="Weight" Binding="{Binding Weight}" Width="120" />
                    <controls:DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="200" />
                </controls:DataGrid.Columns>
            </controls:DataGrid>

        </Grid>
    </ScrollViewer>
</Page>
