<Page
    x:Class="agrify.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:utu="using:Uno.Toolkit.UI"
    xmlns:utum="using:Uno.Toolkit.UI.Material"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:um="using:Uno.Material"
    xmlns:ut="using:Uno.Themes"
    xmlns:local="using:agrify"
    xmlns:vm="using:agrify.ViewModels"
    mc:Ignorable="d">

    <Page.DataContext>
        <vm:LoginViewModel />
    </Page.DataContext>

    <Page.Resources>
        <x:String x:Key="Icon_Size_48">
            F1 M 16.666667938232422 18.75 L 16.666667938232422 16.666666666666668
            C 16.666667938232422 15.561597918470701 16.227680254763115 14.50179076443116
            15.446278637919931 13.720389207204184 C 14.664877021076748 12.938987649977207
            13.605069786180337 12.500000000000004 12.500000953674316 12.5 L 4.1666669845581055
            12.5 C 3.0615981520520847 12.500000000000002 2.0017899237448518 12.938987649977207
            1.2203883069016683 13.720389207204184 C 0.4389866900584849 14.50179076443116
            9.25185924440376e-16 15.561597918470701 0 16.666666666666668 L 0 18.75
            M 8.333333969116211 8.333333333333334 C 10.634520467848688 8.333333333333334
            12.500000953674316 6.4678529898325605 12.500000953674316 4.166666666666667
            C 12.500000953674316 1.8654800951480865 10.634520467848688 0 8.333333969116211 0
            C 6.032147222031028 0 4.1666669845581055 1.8654800951480865 4.1666669845581055
            4.166666666666667 C 4.1666669845581055 6.4678529898325605 6.032147222031028
            8.333333333333334 8.333333969116211 8.333333333333334 Z
        </x:String>
    </Page.Resources>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="Auto">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#8DC63F" Offset="0" />
                <GradientStop Color="#006F31" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Viewbox Margin="10" Stretch="Uniform"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top">

            <Grid Height="600" Width="800" >

                <Rectangle Fill="White" RadiusX="56" RadiusY="56"
                    utu:AutoLayout.IsIndependentLayout="True"
                    Margin="167,94,0,0"
                    VerticalAlignment="Top" HorizontalAlignment="Left"
                    Width="630" Height="437" />

                <Border utu:AutoLayout.IsIndependentLayout="True"
                        Margin="487,127,0,0"
                        VerticalAlignment="Top" HorizontalAlignment="Left"
                        Width="286" Height="383" CornerRadius="46">
                    <Image Source="ms-appx:///Assets/Icons/image.png" />
                </Border>

                <!-- AGRIFY TITLE -->
                <utu:AutoLayout Margin="210,122,0,0" Width="235" CounterAxisAlignment="Start"
                                utu:AutoLayout.IsIndependentLayout="True"
                                VerticalAlignment="Top" HorizontalAlignment="Left"
                                Height="70">
                    <Image Source="ms-appx:///Assets/Icons/agrifytitle.png"
                           Stretch="Uniform" />
                </utu:AutoLayout>

                <!-- USERNAME -->
                <utu:AutoLayout CounterAxisAlignment="Start"
                                utu:AutoLayout.IsIndependentLayout="True"
                                Margin="220,281,0,0"
                                VerticalAlignment="Top" HorizontalAlignment="Left"
                                Width="241" Height="42">
                    <TextBox    
                        utu:AutoLayout.IsIndependentLayout="True"
                        Width="241" Height="42"
                        Padding="14,10,0,0" 
                        PlaceholderText="USERNAME"
                        Foreground="Black"
                        PlaceholderForeground="#708751"
                        Background="#EAFFCE"
                        BorderThickness="0"
                        VerticalAlignment="Top"
                        Text="{Binding Username, Mode=TwoWay}"
                        FontFamily="ms-appx:///Assets/NewFolder/Poppins-Regular.ttf#Poppins"
                        HorizontalAlignment="Left" />
                </utu:AutoLayout>

                <!-- PASSWORD -->
                <utu:AutoLayout CounterAxisAlignment="Start"
                utu:AutoLayout.IsIndependentLayout="True"
                Margin="220,338,0,0"
                VerticalAlignment="Top" HorizontalAlignment="Left"
                Width="241" Height="42">
                    <PasswordBox Background="#EAFFCE" 
                Width="241" Height="42"
                Padding="14,10,0,0"
                PlaceholderText="PASSWORD"
                Foreground="Black"
                PlaceholderForeground="#708751"
                BorderThickness="0"
                VerticalAlignment="Top"
                Password="{Binding Password, Mode=TwoWay}"
                FontFamily="ms-appx:///Assets/NewFolder/Poppins-Regular.ttf#Poppins"
                HorizontalAlignment="Left" />
                </utu:AutoLayout>

                <!-- ERROR MESSAGE -->
                <TextBlock 
                    Text="{Binding ErrorMessage}"
                    Foreground="Red"
                    FontWeight="Bold"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    Margin="220,375,0,0"
                    TextWrapping="Wrap"
                    Width="241"
                    FontFamily="ms-appx:///Assets/NewFolder/Poppins-SemiBold.ttf#Poppins"
                    utu:AutoLayout.IsIndependentLayout="True" />

                <!-- LOGIN BUTTON -->
                <Button Command="{Binding LoginCommand}"
                        Width="241"
                        Height="42"
                        Content="LOGIN"
                        FontWeight="SemiBold"
                        Foreground="White"
                        BorderThickness="0"
                        FontFamily="ms-appx:///Assets/NewFolder/Poppins-SemiBold.ttf#Poppins"
                        utu:AutoLayout.IsIndependentLayout="True"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Margin="220,399,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid" CornerRadius="15">
                                <Grid.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#66BB6A" Offset="0" />
                                        <GradientStop Color="#388E3C" Offset="1" />
                                    </LinearGradientBrush>
                                </Grid.Background>
                                <ContentPresenter HorizontalAlignment="Center" 
                                                 VerticalAlignment="Center"
                                                 ContentTemplate="{TemplateBinding ContentTemplate}"
                                                 Content="{TemplateBinding Content}"/>
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- DESCRIPTION -->
                <TextBlock FontSize="11" 
                           TextAlignment="Justify" 
                           TextWrapping="Wrap"
                           Text="A digital farm management system that simplifies livestock and crop operations by centralizing records, finances, and analytics to boost efficiency and profitability."
                           utu:AutoLayout.IsIndependentLayout="True"
                           Margin="218,205,0,0"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Left"
                           Width="245"
                           Foreground="Black"
                           FontFamily="ms-appx:///Assets/NewFolder/Poppins-Regular.ttf#Poppins" />
            </Grid>
        </Viewbox>
    </Grid>
</Page>
