<Page
    x:Class="agrify.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:utu="using:Uno.Toolkit.UI"
    xmlns:utum="using:Uno.Toolkit.UI.Material"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:um="using:Uno.Material"
    xmlns:ut="using:Uno.Themes"
    xmlns:uen="using:Uno.Extensions.Navigation.UI"
    xmlns:uer="using:Uno.Extensions.Reactive.UI"
    xmlns:local="using:agrify"
    xmlns:vm="using:agrify.ViewModels"
    mc:Ignorable="d">

    <!--
    This sets up the connection between your View (XAML)
    and your ViewModel (C#).
    -->
    <Page.DataContext>
        <vm:LoginViewModel />
    </Page.DataContext>

    <Page.Resources>
        <x:String x:Key="Icon_Size_48">
            F1 M 16.666667938232422 18.75 L 16.666667938232422 16.666666666666668
            C 16.666667938232422 15.561597918470701 16.227680254763115 14.50179076443116
            15.446278637919931 13.720389207204184 C 14.664877021076748 12.938987649977207
            13.605069786180337 12.500000000000004 12.500000953674316 12.5 L 4.1666669845581055
            12.5 C 3.0615981520520847 12.500000000000002 2.0017899237448518 12.938987649977207
            1.2203883069016683 13.720389207204184 C 0.4389866900584849 14.50179076443116
            9.25185924440376e-16 15.561597918470701 0 16.666666666666668 L 0 18.75
            M 8.333333969116211 8.333333333333334 C 10.634520467848688 8.333333333333334
            12.500000953674316 6.4678529898325605 12.500000953674316 4.166666666666667
            C 12.500000953674316 1.8654800951480865 10.634520467848688 0 8.333333969116211 0
            C 6.032147222031028 0 4.1666669845581055 1.8654800951480865 4.1666669845581055
            4.166666666666667 C 4.1666669845581055 6.4678529898325605 6.032147222031028
            8.333333333333334 8.333333969116211 8.333333333333334 Z
        </x:String>
    </Page.Resources>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="Auto">
        <!-- ... your gradient background ... -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#8DC63F" Offset="0" />
                <GradientStop Color="#006F31" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Viewbox Margin="10" Stretch="Uniform"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top">

            <Grid Height="600" Width="800" >

                <!-- ... your white rectangle, border, image, title ... -->
                <Rectangle Fill="White" RadiusX="56" RadiusY="56"
                    utu:AutoLayout.IsIndependentLayout="True"
                    Margin="167,94,0,0"
                    VerticalAlignment="Top" HorizontalAlignment="Left"
                    Width="630" Height="437" />

                <Border utu:AutoLayout.IsIndependentLayout="True"
                        Margin="487,127,0,0"
                        VerticalAlignment="Top" HorizontalAlignment="Left"
                        Width="286" Height="383" CornerRadius="46">
                    <Image Source="[https://picsum.photos/286/383](https://picsum.photos/286/383)" />
                </Border>

                <utu:AutoLayout Width="235" CounterAxisAlignment="Start"
                                utu:AutoLayout.IsIndependentLayout="True"
                                Margin="220,137,0,0"
                                VerticalAlignment="Top" HorizontalAlignment="Left"
                                Height="64">
                    <TextBlock FontSize="54" Text="AGRI.FY"
                                FontWeight="Bold" Foreground="DarkSeaGreen"
                                utu:AutoLayout.CounterAlignment="Start" />
                </utu:AutoLayout>

                <!-- ... your USERNAME and PASSWORD fields ... -->
                <utu:AutoLayout CounterAxisAlignment="Start"
                                utu:AutoLayout.IsIndependentLayout="True"
                                Margin="220,271,0,0"
                                VerticalAlignment="Top" HorizontalAlignment="Left"
                                Width="241" Height="42">
                    <TextBox    
                        utu:AutoLayout.IsIndependentLayout="True"
                        Width="241" Height="42"
                        Padding="14,10,0,0" 
                        PlaceholderText="USERNAME"
                        Foreground="Black"
                        Background="#EAFFCE"
                        BorderThickness="0"
                        VerticalAlignment="Top"
                        Text="{Binding Username, Mode=TwoWay}"
                        HorizontalAlignment="Left" />
                </utu:AutoLayout>

                <utu:AutoLayout CounterAxisAlignment="Start"
                                utu:AutoLayout.IsIndependentLayout="True"
                                Margin="220,328,0,0"
                                VerticalAlignment="Top" HorizontalAlignment="Left"
                                Width="241" Height="42">
                    <PasswordBox Background="#EAFFCE" 
                                utu:AutoLayout.IsIndependentLayout="True"
                                Width="241" Height="42"
                                Padding="14,10,0,0"
                                PlaceholderText="PASSWORD"
                                Foreground="Black"
                                PlaceholderForeground="Black"
                                BorderThickness="0"
                                VerticalAlignment="Top"
                                Password="{Binding Password, Mode=TwoWay}"
                                HorizontalAlignment="Left" />
                </utu:AutoLayout>

                <TextBlock 
    Text="{Binding ErrorMessage}"
    Foreground="Red"
    FontWeight="Bold"
    VerticalAlignment="Top"
    HorizontalAlignment="Left"
    Margin="220,375,0,0"
    TextWrapping="Wrap"
    Width="241"
    utu:AutoLayout.IsIndependentLayout="True" />
                <!-- 
                THIS IS THE KEY PART!
                We bind the button's Command to the "LoginCommand"
                we created in our ViewModel.
                (I removed x:Name, as it's not needed for MVVM)
                -->
                <Button Command="{Binding LoginCommand}"
                        Width="241"
                        Height="42"
                        Content="LOGIN"
                        FontWeight="SemiBold"
                        Foreground="White"
                        BorderThickness="0"
                        utu:AutoLayout.IsIndependentLayout="True"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Margin="220,399,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid" CornerRadius="15">
                                <Grid.Background>
                                    <SolidColorBrush x:Name="ButtonBackgroundBrush" Color="#006F31"/>
                                </Grid.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- description -->
                <TextBlock FontSize="11" TextAlignment="Justify" TextWrapping="Wrap"
                           Text="A digital farm management system that simplifies livestock and crop operations by centralizing records, finances, and analytics to boost efficiency and profitability."
                           utu:AutoLayout.IsIndependentLayout="True"
                           Margin="218,205,0,0"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Left"
                           Width="245"
                           Foreground="Black" />
            </Grid>
        </Viewbox>
    </Grid>
</Page>
