                             Content="Insights"
                             GroupName="Navigation"
                             Style="{StaticResource SidebarRadioButtonStyle}"
                             Checked="Navigation_Checked"
                             Tag="insights"
                             Visibility="{Binding CanSeeAccountantContent, Converter={StaticResource BoolToVisibilityConverter}}" /> />

