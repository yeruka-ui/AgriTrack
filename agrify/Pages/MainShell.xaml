    <!-- This is the new page structure: A 2-column Grid -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Column 0: The Sidebar (fixed width from your design) -->
            <ColumnDefinition Width="287" />
            <!-- Column 1: The Content Area (takes all remaining space) -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <!-- 
            UPDATED:
            Replaced the simple Rectangle with your LinearGradientBrush
            -->
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#8DC63F" Offset="0" />
                    <GradientStop Color="#006F31" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Logo -->

            <!-- This StackPanel will hold our new navigation buttons -->
            <StackPanel Margin="0,130,0,0" VerticalAlignment="Top">

                <!-- 
                This is a functional RadioButton, styled to look
                like your text. It's in a "GroupName" so only one
                can be checked at a time.
                -->
                <RadioButton x:Name="DashboardButton"
                             Content="Dashboard"
                             GroupName="Navigation"
                             Style="{StaticResource SidebarRadioButtonStyle}"
                             Checked="Navigation_Checked"
                             Tag="dashboard" />

                <RadioButton x:Name="CalendarButton"
                             Content="Calendar"
                             GroupName="Navigation"
                             Style="{StaticResource SidebarRadioButtonStyle}"
                             Checked="Navigation_Checked"
                             Tag="calendar" />

                <RadioButton x:Name="LivestockButton"
                             Content="Livestock"
                             GroupName="Navigation"
                             Style="{StaticResource SidebarRadioButtonStyle}"
                             Checked="Navigation_Checked"
                             Tag="livestock"
                             Visibility="{Binding CanSeeManagerContent, Converter={StaticResource BoolToVisibilityConverter}}" />

                <RadioButton x:Name="ProduceButton"
                             Content="Produce"
                             GroupName="Navigation"
                             Style="{StaticResource SidebarRadioButtonStyle}"
                             Checked="Navigation_Checked"
                             Tag="produce"
                             Visibility="{Binding CanSeeManagerContent, Converter={StaticResource BoolToVisibilityConverter}}" />

                <RadioButton x:Name="SuppliesButton"
                             Content="Supplies"
                             GroupName="Navigation"
                             Style="{StaticResource SidebarRadioButtonStyle}"
                             Checked="Navigation_Checked"
                             Tag="supplies"
                             Visibility="{Binding CanSeeManagerContent, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- UPDATED: Set Foreground to a light gray for readability -->
                <TextBlock Text="Analytics" Margin="20,15,0,5" FontWeight="Bold" Foreground="#CCFFFFFF" />

