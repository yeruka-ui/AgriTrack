                <RadioButton x:Name="ReportsButton"
                             Content="Reports"
                             GroupName="Navigation"
                             Style="{StaticResource SidebarRadioButtonStyle}"
                             Checked="Navigation_Checked"
                             Tag="reports"
                             Visibility="{Binding CanSeeAllContent, Converter={StaticResource BoolToVisibilityConverter}}" />

