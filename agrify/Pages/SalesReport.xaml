<Page
    x:Class="agrify.Pages.SalesReport"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:agrify.Pages"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded"
    Background="#FF2D2D30">

    <Grid Background="White" Padding="48" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Sales Entry" Foreground="White" FontSize="20" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,6"/>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="TYPE" Foreground="LightGray" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox x:Name="ItemTypeComboBox" HorizontalAlignment="Stretch" SelectionChanged="ItemTypeComboBox_SelectionChanged">
                    <ComboBoxItem Content="Produce" />
                    <ComboBoxItem Content="Livestock" />
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                <TextBlock Text="ITEM" Foreground="LightGray" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox x:Name="ItemComboBox" HorizontalAlignment="Stretch" 
                          SelectionChanged="ItemComboBox_SelectionChanged"
                          PlaceholderText="Select item..." />
                <TextBlock x:Name="AvailableStockTextBlock" Text="Available: -" 
                           FontSize="18" Foreground="Gray" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                <TextBlock Text="QTY" Foreground="LightGray" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <NumberBox x:Name="QuantityNumberBox" Minimum="1" Value="1" 
                           ValueChanged="Input_ValueChanged" SpinButtonPlacementMode="Compact" />
            </StackPanel>

            <StackPanel Grid.Column="3" Margin="0,0,12,0">
                <TextBlock Text="UNIT PRICE ($)" Foreground="LightGray" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <NumberBox x:Name="UnitPriceNumberBox" Minimum="0" Value="0" 
                           ValueChanged="Input_ValueChanged" SpinButtonPlacementMode="Compact"/>
            </StackPanel>

            <StackPanel Grid.Column="4" VerticalAlignment="Top">
                <TextBlock Text="TOTAL" Foreground="LightGray" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock x:Name="TotalTextBlock" Text="$0.00" Foreground="LightGreen" 
                           FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>

                <Button Background="#8DC63F" x:Name="SubmitSaleButton" Content="RECORD SALE" 
                        HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"
                        Click="SubmitSaleButton_Click"/>

                <TextBlock x:Name="SaleMessageTextBlock" Foreground="Orange" 
                           FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <TextBox x:Name="SalesSearchBox" Grid.Row="2" PlaceholderText="Search history..." Margin="0,0,0,12"
                 TextChanged="SalesSearchBox_TextChanged"/>

        <controls:DataGrid x:Name="SalesDataGrid"
                           Grid.Row="3"
                           AutoGenerateColumns="False"
                           IsReadOnly="True"
                           GridLinesVisibility="Horizontal"
                           HorizontalScrollBarVisibility="Auto">
            <controls:DataGrid.Columns>
                <controls:DataGridTextColumn Header="Date" Binding="{Binding DateString}" Width="120"/>
                <controls:DataGridTextColumn Header="Type" Binding="{Binding ItemType}" Width="100"/>
                <controls:DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="*"/>
                <controls:DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="80"/>
                <controls:DataGridTextColumn Header="Price" Binding="{Binding UnitPrice}" Width="100" />
                <controls:DataGridTextColumn Header="Total" Binding="{Binding TotalAmount}" Width="100"/>
            </controls:DataGrid.Columns>
        </controls:DataGrid>
    </Grid>
</Page>
