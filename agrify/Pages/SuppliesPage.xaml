<Page
    x:Class="agrify.Pages.SuppliesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:agrify.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    mc:Ignorable="d"
    Background="#FF2D2D30"
    Loaded="Page_Loaded">
    <Grid Padding="48">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="INPUT INFORMATION"
                   Grid.Row="0"
                   Foreground="White"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,-30,0,10"/>

        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="180" />
                <ColumnDefinition Width="1*" MinWidth="120" />
                <ColumnDefinition Width="1*" MinWidth="120" />
                <ColumnDefinition Width="1.5*" MinWidth="150" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="SUPPLY / ITEM" Foreground="LightGray" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="SupplyTypeComboBox"
                              Grid.Column="0"
                              Background="#FFD9FFD9"
                              Foreground="Black" 
                              HorizontalAlignment="Stretch"
                              PlaceholderText="Select supply type..." />

                    <Button x:Name="AddSupplyTypeButton"
                            Grid.Column="1"
                            Content="+"
                            FontWeight="Bold"
                            Margin="5,0,0,0"
                            Click="AddSupplyTypeButton_Click">
                        <Button.Flyout>
                            <Flyout x:Name="AddSupplyTypeFlyout" Placement="Bottom">
                                <StackPanel Spacing="10" Width="250">
                                    <TextBlock Text="Add New Supply Type" FontWeight="Bold" />
                                    <TextBox x:Name="NewSupplyTypeTextBox" PlaceholderText="e.g., Fertilizer" Foreground="Black"/>
                                    <TextBlock x:Name="NewSupplyTypeErrorTextBlock" Foreground="Red" TextWrapping="Wrap" />
                                    <Button x:Name="SaveNewSupplyTypeButton" Content="Save" Click="SaveNewSupplyTypeButton_Click" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="10,0,10,0">
                <TextBlock Text="QUANTITY" Foreground="LightGray" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <NumberBox x:Name="QuantityNumberBox"
                           PlaceholderText="e.g., 50"
                           Background="#FFD9FFD9"
                           Foreground="Black"
                           SpinButtonPlacementMode="Compact"
                           SmallChange="1"
                           LargeChange="10"
                           Value="0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Margin="10,0,10,0">
                <TextBlock Text="COST (PER UNIT)" Foreground="LightGray" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <NumberBox x:Name="UnitCostNumberBox"
                           PlaceholderText="e.g., 12.50"
                           Background="#FFD9FFD9"
                           Foreground="Black"
                           SpinButtonPlacementMode="Compact"
                           SmallChange="0.1"
                           LargeChange="1.0"
                           Value="0"/>
            </StackPanel>

            <StackPanel Grid.Column="3" Margin="10,0,10,0">
                <TextBlock Text="DATE ACQUIRED" Foreground="LightGray" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <DatePicker x:Name="DateAcquiredPicker" Background="#FFD9FFD9" Foreground="Black" />
            </StackPanel>

        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <TextBlock Text="NOTES (OPTIONAL)" Foreground="LightGray" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox MinWidth="500" HorizontalAlignment="Left" x:Name="NotesTextBox"
                         PlaceholderText="Add any notes here (e.g., supplier, quality)..."
                         Background="#FFD9FFD9"
                         Foreground="Black"
                         Height="90"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="SubmitButton"
                            Content="SUBMIT"
                            Width="120"
                            Background="#FF006400"
                            Foreground="White"
                            FontWeight="Bold"
                            Click="SubmitButton_Click" />

                    <Button x:Name="EditButton"
                            Content="EDIT"
                            Width="90"
                            Background="#FFB8860B" 
                            Foreground="White"
                            FontWeight="Bold"
                            Click="EditButton_Click" />

                    <Button x:Name="RemoveButton"
                            Content="REMOVE"
                            Width="90"
                            Background="#FFB22222"
                            Foreground="White"
                            FontWeight="Bold"
                            Click="RemoveButton_Click" />

                    <Button x:Name="CancelButton"
                            Content="CANCEL"
                            Width="90"
                            Background="#FF696969"
                            Foreground="White"
                            FontWeight="Bold"
                            Click="CancelButton_Click"
                            Visibility="Collapsed"/>
                </StackPanel>

                <TextBlock x:Name="ErrorMessageTextBlock"
                           Foreground="Red"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           MaxWidth="320" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="SUPPLIES DATA"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="Bold"
                       VerticalAlignment="Bottom"/>
            <TextBlock Text="Supplies"
                       Foreground="LightGray"
                       FontSize="14"
                       Margin="10,0,0,0"
                       VerticalAlignment="Bottom"/>
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox MinWidth="500" x:Name="SearchTextBox"
                   PlaceholderText="Search"
                   Grid.Column="0"
                   MaxWidth="300"
                   HorizontalAlignment="Left" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Sort by: " Foreground="LightGray" VerticalAlignment="Center" />
                <ComboBox x:Name="SortComboBox" SelectedIndex="0">
                    <ComboBoxItem Content="Recently Added" />
                    <ComboBoxItem Content="Item Name" />
                    <ComboBoxItem Content="Total Cost" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <controls:DataGrid x:Name="SuppliesDataGrid"
                           Grid.Row="5"
                           AutoGenerateColumns="False"
                           CanUserSortColumns="True"
                           IsReadOnly="True"
                           GridLinesVisibility="Horizontal"
                           HorizontalScrollBarVisibility="Auto"
                           SelectionChanged="SuppliesDataGrid_SelectionChanged">

            <controls:DataGrid.Columns>
                <controls:DataGridTextColumn Header="Supply / Item" Binding="{Binding ItemName}" Width="Auto" />
                <controls:DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="Auto" />
                <controls:DataGridTextColumn Header="Cost (per Unit)" Binding="{Binding UnitCost}" Width="Auto" />
                <controls:DataGridTextColumn Header="Total Cost" Binding="{Binding TotalCost}" Width="Auto" />
                <controls:DataGridTextColumn Header="Date Acquired" Binding="{Binding DateAcquired}" Width="Auto" />
                <controls:DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" />
            </controls:DataGrid.Columns>
        </controls:DataGrid>

    </Grid>
</Page>
