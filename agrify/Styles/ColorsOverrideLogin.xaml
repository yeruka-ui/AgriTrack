<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Remove black focus rectangle globally -->
    <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="Transparent" />
    <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="Transparent" />

    <!-- Override the focus visuals thickness -->
    <Thickness x:Key="FocusVisualMargin">0</Thickness>
    <Thickness x:Key="FocusVisualThickness">0</Thickness>

    <!-- TextBox/PasswordBox focused states: removing focus highlight -->
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#A5D6A7" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#006F31" />
    <SolidColorBrush x:Key="PasswordBoxPlaceholderForegroundBrush" Color="Black" />
    <Color x:Key="PrimaryColor">#4CAF50</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
</ResourceDictionary>
